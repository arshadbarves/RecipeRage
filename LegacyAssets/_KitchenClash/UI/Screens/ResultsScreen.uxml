<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Styles/DesignSystem.uss" />
    <ui:VisualElement name="results-root" class="pc-match-shell" style="align-items: center; justify-content: center;">
        <ui:Label name="winner-label" text="VICTORY" class="pc-results-verdict" />

        <ui:VisualElement class="pc-results-score-row">
            <ui:VisualElement class="pc-panel pc-results-score-box">
                <ui:Label text="TEAM A" class="pc-results-score-box__team" />
                <ui:Label name="score-team-0" text="0" class="pc-results-score-box__score" />
            </ui:VisualElement>
            <ui:VisualElement class="pc-vs">
                <ui:Label text="VS" class="pc-vs__mark" style="font-size: 48px;" />
            </ui:VisualElement>
            <ui:VisualElement class="pc-panel pc-results-score-box">
                <ui:Label text="TEAM B" class="pc-results-score-box__team" />
                <ui:Label name="score-team-1" text="0" class="pc-results-score-box__score" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="reward-panel" class="pc-panel pc-results-reward">
            <ui:Label text="REWARDS" class="pc-results-reward__title" />
            <ui:VisualElement class="pc-results-reward__row">
                <ui:Label text="Match payout" class="pc-player-slot__status" />
                <ui:Label name="reward-delta-coins" text="+0" class="pc-chip pc-chip--soft" />
            </ui:VisualElement>
            <ui:VisualElement class="pc-results-reward__row">
                <ui:Label text="Wallet" class="pc-player-slot__status" />
                <ui:VisualElement style="flex-direction: row;">
                    <ui:Label name="wallet-coins" text="0" class="pc-chip pc-chip--soft" style="margin-right: 8px;" />
                    <ui:Label name="wallet-gems" text="0" class="pc-chip pc-chip--hard" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="pc-match-footer" style="margin-top: 24px;">
            <ui:Button name="lobby-btn" text="RETURN HOME" class="pc-btn pc-btn--primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
