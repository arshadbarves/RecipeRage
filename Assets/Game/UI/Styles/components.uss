/* ═══════════════════════════════════════════════════════════════════════════
   PLAYCENTER STUDIOS — Components (dark, minimal)
   Tokens defined on .screen in playcenter.uss (imported first).
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Buttons ─────────────────────────────────────────────────────────────── */

.btn {
    min-height: 52px;
    padding-left: var(--space-5);
    padding-right: var(--space-5);
    justify-content: center;
    align-items: center;

    background-color: var(--color-red);
    border-radius: var(--radius-md);
    border-bottom-width: var(--border-thick);
    border-bottom-color: var(--color-red-dark);
    border-left-width: 0; border-right-width: 0; border-top-width: 0;

    color: var(--color-text);
    font-size: var(--text-lg);
    -unity-font-style: normal;
    -unity-text-align: middle-center;

    transition-property: background-color, translate, border-bottom-width;
    transition-duration: var(--duration-base);
    transition-timing-function: var(--ease-out);
}

.btn:hover { background-color: var(--color-red-bright); }
.btn:active { translate: 0 2px; border-bottom-width: 0; }

.btn:disabled {
    background-color: var(--color-bg-overlay);
    border-bottom-color: var(--color-border);
    color: var(--color-text-dim);
}

/* variants */
.btn--secondary {
    background-color: var(--color-purple);
    border-bottom-color: #4C3FB8;
}
.btn--secondary:hover { background-color: #8579F0; }

.btn--gold {
    background-color: var(--color-gold);
    border-bottom-color: #9A7B1D;
    color: #141619;
}
.btn--gold:hover { background-color: #E3BC2E; }

.btn--ghost {
    background-color: var(--color-bg-overlay);
    border-bottom-color: var(--color-border);
    color: var(--color-text);
}
.btn--ghost:hover { background-color: var(--color-border-bright); border-bottom-color: var(--color-red); }

.btn--destructive {
    background-color: var(--color-red-dark);
    border-bottom-color: #6E1E1E;
}

.btn--small { min-height: 40px; padding-left: var(--space-4); padding-right: var(--space-4); font-size: var(--text-base); }
.btn--large { min-height: 68px; padding-left: var(--space-7); padding-right: var(--space-7); font-size: var(--text-xl); }

/* ── Cards ───────────────────────────────────────────────────────────────── */

.card {
    background-color: var(--color-bg-raised);
    border-radius: var(--radius-lg);
    border-bottom-width: var(--border-thin);
    border-bottom-color: var(--color-border);
    border-left-width: 0; border-right-width: 0; border-top-width: 0;
    padding: var(--space-5);
    margin: var(--space-2);
}

.card--interactive {
    transition-property: translate, border-bottom-color;
    transition-duration: var(--duration-base);
}
.card--interactive:hover { translate: 0 -2px; border-bottom-color: var(--color-red); }
.card--interactive:active { translate: 0 1px; }

.card--recessed {
    background-color: var(--color-bg);
    border-bottom-color: var(--color-border);
}

/* ── Top bar ─────────────────────────────────────────────────────────────── */

.topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    padding-left: var(--space-5);
    padding-right: var(--space-5);
    background-color: var(--color-bg-raised);
    border-bottom-width: var(--border-thin);
    border-bottom-color: var(--color-border);
}

.topbar__group { flex-direction: row; align-items: center; }

/* ── Currency chips ──────────────────────────────────────────────────────── */

.chip {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    margin-left: var(--space-2);
    margin-right: var(--space-2);
    background-color: var(--color-bg-overlay);
    border-radius: var(--radius-pill);
    border-bottom-width: var(--border-thin);
    border-bottom-color: var(--color-border);
}

.chip__icon { width: 20px; height: 20px; margin-right: var(--space-2); }

.chip__label {
    font-size: var(--text-base);
    -unity-font-style: normal;
    color: var(--color-text);
}

.chip--gold { border-bottom-color: var(--color-gold); }
.chip--gold .chip__label { color: var(--color-gold); }

.chip--team { background-color: #2A1E22; border-bottom-color: var(--color-red); }
.chip--enemy { background-color: #1E2230; border-bottom-color: var(--color-purple); }

/* ── Bottom tab bar ──────────────────────────────────────────────────────── */

.tabbar {
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    height: 76px;
    background-color: var(--color-bg-raised);
    border-top-width: var(--border-thin);
    border-top-color: var(--color-border);
}

.tab {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom-width: var(--border-thick);
    border-bottom-color: #00000000;
    transition-property: border-bottom-color, scale;
    transition-duration: var(--duration-base);
}

.tab--active { border-bottom-color: var(--color-red); }

.tab__icon { width: 24px; height: 24px; margin-bottom: var(--space-1); }

.tab__label {
    font-size: var(--text-xs);
    -unity-font-style: normal;
    color: var(--color-text-dim);
}

.tab--active .tab__label { color: var(--color-text); }

/* ── Progress bars ───────────────────────────────────────────────────────── */

.bar {
    height: 8px;
    background-color: var(--color-bg-overlay);
    border-radius: var(--radius-pill);
    overflow: hidden;
}

.bar__fill {
    height: 100%;
    background-color: var(--color-red);
    border-top-left-radius: var(--radius-pill);
    border-bottom-left-radius: var(--radius-pill);
}

.bar__fill--xp { background-color: var(--color-purple); }
.bar__fill--gold { background-color: var(--color-gold); }
.bar__fill--burn { background-color: var(--color-red-bright); }
.bar__fill--success { background-color: var(--color-success); }

/* ── Badges ──────────────────────────────────────────────────────────────── */

.badge {
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-red);
    color: var(--color-text);
    font-size: var(--text-xs);
    -unity-font-style: normal;
    border-radius: var(--radius-sm);
}

.badge--rare { background-color: var(--color-purple); }
.badge--epic { background-color: var(--color-gold); color: #141619; }
.badge--locked { background-color: var(--color-bg-overlay); color: var(--color-text-dim); }

/* ── Chef card ───────────────────────────────────────────────────────────── */

.chef-card {
    width: 130px;
    height: 170px;
    margin: var(--space-2);
    align-items: center;
    justify-content: flex-end;
    background-color: var(--color-bg-raised);
    border-radius: var(--radius-lg);
    border-bottom-width: var(--border-thin);
    border-bottom-color: var(--color-border);
    border-left-width: 0; border-right-width: 0; border-top-width: 0;
    transition-property: translate, border-bottom-color, scale;
    transition-duration: var(--duration-base);
}

.chef-card:hover { translate: 0 -2px; border-bottom-color: var(--color-red); }
.chef-card:active { scale: 0.98; }

.chef-card--selected { border-bottom-color: var(--color-red); border-bottom-width: var(--border-thick); }
.chef-card--locked { background-color: var(--color-bg); border-bottom-color: var(--color-border); }

.chef-card-portrait {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 30px;
    border-top-left-radius: var(--radius-lg);
    border-top-right-radius: var(--radius-lg);
    background-color: var(--color-bg-overlay);
}

.chef-card-label {
    height: 30px;
    -unity-text-align: middle-center;
    font-size: var(--text-sm);
    -unity-font-style: normal;
    color: var(--color-text);
}

.chef-card--locked .chef-card-label { color: var(--color-text-dim); }

/* ── Titles / text ───────────────────────────────────────────────────────── */

.section-title {
    font-size: var(--text-xl);
    -unity-font-style: normal;
    color: var(--color-text);
    margin: var(--space-4);
}

.display {
    font-size: var(--text-3xl);
    -unity-font-style: normal;
    color: var(--color-text);
    -unity-text-align: middle-center;
}

.display--victory { color: var(--color-success); }
.display--defeat { color: var(--color-red); }

.text-soft { color: var(--color-text-dim); }
.text-faint { color: var(--color-text-faint); }
.text-primary { color: var(--color-red); }
.text-secondary { color: var(--color-purple); }
.text-accent-dark { color: var(--color-gold); }
.text-success-dark { color: var(--color-success); }
.heading { -unity-font-style: normal; }

/* ── List rows ───────────────────────────────────────────────────────────── */

.row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    padding: var(--space-3);
    margin: var(--space-1);
    background-color: var(--color-bg-raised);
    border-radius: var(--radius-md);
    border-bottom-width: var(--border-thin);
    border-bottom-color: var(--color-border);
}

.row__title { font-size: var(--text-base); -unity-font-style: normal; color: var(--color-text); }
.row__subtitle { font-size: var(--text-sm); color: var(--color-text-dim); }

/* ── Tutorial (dark) ─────────────────────────────────────────────────────── */

.tutorial-panel {
    position: absolute;
    top: 24px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    min-width: 520px;
    max-width: 720px;
    padding: 20px 28px;
    background-color: var(--color-bg-raised);
    border-bottom-color: var(--color-border);
}

.tutorial-color-dot {
    width: 32px; height: 32px;
    border-radius: 999px;
    background-color: #B33232;
    margin-right: 16px; flex-shrink: 0;
}

.tutorial-instruction { font-size: 22px; color: var(--color-text); -unity-font-style: normal; }
.tutorial-button-hint { font-size: 16px; color: var(--color-text-dim); margin-top: 4px; }

.tutorial-step-progress {
    position: absolute; top: 24px; right: 24px;
    background-color: var(--color-bg-overlay);
    border-radius: 999px;
    padding: 8px 18px;
    border-bottom-width: var(--border-thin);
    border-bottom-color: var(--color-border);
}

.tutorial-step-count { font-size: 20px; color: var(--color-red); -unity-font-style: normal; }

.tutorial-numeric-progress {
    position: absolute; top: 116px; left: 50%;
    translate: -50% 0; width: 320px; align-items: center;
}

.tutorial-progress-bar { width: 100%; height: 8px; }
.tutorial-progress-label { font-size: 16px; color: var(--color-text); -unity-font-style: normal; margin-top: 6px; -unity-text-align: middle-center; }

.tutorial-arrow { position: absolute; width: 64px; height: 64px; align-items: center; justify-content: center; }
.tutorial-arrow-text { font-size: 52px; color: #B33232; -unity-font-style: normal; }

/* ── Game mode cards ─────────────────────────────────────────────────────── */

.mode-card {
    width: 320px;
    padding: 28px;
    margin: 16px;
    align-items: center;
}

.mode-card__title {
    font-size: 28px;
    color: var(--color-text);
    -unity-font-style: bold;
}

.mode-card__desc {
    font-size: 15px;
    color: var(--color-text-dim);
    margin-top: 8px;
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

/* ── Profile ─────────────────────────────────────────────────────────────── */

.profile-avatar {
    width: 96px;
    height: 96px;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    background-color: var(--color-bg-overlay);
    border-bottom-width: var(--border-thick);
    border-bottom-color: var(--color-red);
}

.profile-stat {
    font-size: 32px;
    color: var(--color-text);
    -unity-font-style: bold;
}

.center { align-items: center; justify-content: center; }
.row-layout { flex-direction: row; }
.grow { flex-grow: 1; }

.icon-coin { background-image: resource('UI/Icons/icon_coin'); }
.icon-trophy { background-image: resource('UI/Icons/icon_trophy'); }
.icon-chef { background-image: resource('UI/Icons/icon_chef'); }
.icon-play { background-image: resource('UI/Icons/icon_play'); }
.icon-chop { background-image: resource('UI/Icons/icon_chop'); }
.icon-gear { background-image: resource('UI/Icons/icon_gear'); }
.icon-friends { background-image: resource('UI/Icons/icon_friends'); }
.icon-star { background-image: resource('UI/Icons/icon_star'); }
.icon-plate { background-image: resource('UI/Icons/icon_plate'); }
