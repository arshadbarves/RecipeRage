<UXML xmlns="UnityEngine.UIElements">
    <Style src="../Styles/clay-kitchen.uss" />
    <VisualElement name="main-menu" class="screen">

        <!-- Top bar -->
        <VisualElement name="topbar" class="topbar">
            <VisualElement class="topbar__group">
                <VisualElement name="profile-avatar" class="chip" style="width:56px;height:56px;padding:0;" />
                <Label name="profile-name" class="heading" text="Chef" style="font-size:20px;margin-left:12px;" />
            </VisualElement>
            <VisualElement class="topbar__group">
                <VisualElement name="coin-chip" class="chip chip--gold">
                    <VisualElement class="chip__icon" />
                    <Label name="coin-count" class="chip__label" text="0" />
                </VisualElement>
                <VisualElement name="trophy-chip" class="chip">
                    <VisualElement class="chip__icon" />
                    <Label name="trophy-count" class="chip__label" text="0" />
                </VisualElement>
                <Button name="friends-button" class="btn btn--small btn--ghost" text="Friends" />
                <Button name="settings-button" class="btn btn--small btn--ghost" text="⚙" />
            </VisualElement>
        </VisualElement>

        <!-- Body: showcase + play column -->
        <VisualElement class="row-layout grow">
            <!-- 3D chef showcase -->
            <VisualElement name="showcase-panel" class="card" style="flex-grow:1; margin:24px; padding:0;">
                <VisualElement name="chef-showcase" style="flex-grow:1;" />
                <VisualElement style="padding:16px; align-items:center;">
                    <Label name="chef-name" class="heading" text="Gordon" style="font-size:28px;" />
                    <Label name="chef-level" class="text-soft" text="Level 1" style="font-size:16px;" />
                </VisualElement>
            </VisualElement>

            <!-- Play column -->
            <VisualElement class="center" style="width:420px; margin:24px;">
                <Button name="play-button" class="btn btn--large" text="PLAY" style="width:100%; height:96px; font-size:36px; margin-bottom:24px;" />
                <VisualElement name="daily-rewards" class="card" style="width:100%;">
                    <Label class="heading" text="Daily Rewards" style="font-size:20px;margin-bottom:12px;" />
                    <VisualElement class="row-layout" style="justify-content:space-between;">
                        <Button name="daily-ad-button" class="btn btn--accent btn--small" text="Watch Ad: +100 💰" />
                    </VisualElement>
                </VisualElement>
            </VisualElement>
        </VisualElement>

        <!-- Bottom tab bar -->
        <VisualElement name="tabbar" class="tabbar">
            <VisualElement name="chefs-tab" class="tab tab--active">
                <VisualElement class="tab__icon" />
                <Label class="tab__label" text="Chefs" />
            </VisualElement>
            <VisualElement name="shop-tab" class="tab">
                <VisualElement class="tab__icon" />
                <Label class="tab__label" text="Shop" />
            </VisualElement>
            <VisualElement name="events-tab" class="tab">
                <VisualElement class="tab__icon" />
                <Label class="tab__label" text="Events" />
            </VisualElement>
            <VisualElement name="stats-tab" class="tab">
                <VisualElement class="tab__icon" />
                <Label class="tab__label" text="Stats" />
            </VisualElement>
        </VisualElement>
    </VisualElement>
</UXML>
