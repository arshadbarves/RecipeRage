<UXML xmlns="UnityEngine.UIElements">
    <Style src="clay-kitchen.uss" />
    <VisualElement name="countdown-screen" class="screen center" style="background-color: rgba(15,23,42,0.6);">
        <Label name="countdown-number" class="display heading" text="3"
               style="font-size:200px;color:white;-unity-text-align:middle-center;
                      text-shadow: 0 8px 0 var(--color-primary-dark);" />
    </VisualElement>
</UXML>
