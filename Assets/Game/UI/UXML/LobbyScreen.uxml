<UXML xmlns="UnityEngine.UIElements">
    <Style src="../Styles/playcenter.uss" />
    <VisualElement name="lobby-screen" class="screen">

        <VisualElement name="topbar" class="topbar">
            <Button name="back-button" class="btn btn--small btn--ghost" text="← Back" />
            <Label class="heading" text="Select Your Chef" style="font-size:24px;" />
            <Label name="team-status" class="text-soft" text="Team: 1/2" />
        </VisualElement>

        <VisualElement class="row-layout grow">
            <!-- Selected chef preview -->
            <VisualElement class="card center" style="flex-grow:1; margin:24px;">
                <VisualElement name="selected-chef-model" style="flex-grow:1;" />
                <Label name="selected-chef-name" class="heading" text="Gordon" style="font-size:32px;margin-top:16px;" />
                <VisualElement name="chef-ability" class="badge" style="margin-top:8px;">
                    <Label text="+10% Move Speed" style="color:white;" />
                </VisualElement>
            </VisualElement>

            <!-- Chef grid + play -->
            <VisualElement class="center" style="width:460px; margin:24px;">
                <ScrollView name="chef-grid" style="flex-grow:1; width:100%;" />
                <Button name="play-button" class="btn btn--large" text="PLAY" style="width:100%; height:80px; font-size:32px; margin-top:16px;" />
            </VisualElement>
        </VisualElement>
    </VisualElement>
</UXML>
