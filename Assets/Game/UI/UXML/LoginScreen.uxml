<UXML xmlns="UnityEngine.UIElements">
    <Style src="../Styles/clay-kitchen.uss" />
    <VisualElement name="login-screen" class="screen center">

        <!-- Logo block -->
        <VisualElement name="logo" class="center" style="margin-bottom: 48px;">
            <Label name="logo-title" class="display heading" text="RECIPERAGE" style="font-size: 72px;" />
            <Label name="logo-tagline" class="text-soft" text="Cook. Compete. Conquer." style="font-size: 24px; margin-top: 8px;" />
        </VisualElement>

        <!-- Auth buttons -->
        <VisualElement name="button-container" class="center" style="width: 380px;">
            <Button name="facebook-button" class="btn btn--large" text="Sign in with Facebook" style="margin-bottom: 16px; width: 100%;" />
            <Button name="google-button" class="btn btn--large btn--secondary" text="Sign in with Google" style="margin-bottom: 16px; width: 100%;" />
            <Button name="guest-button" class="btn btn--large btn--ghost" text="Play as Guest" style="width: 100%;" />
        </VisualElement>

        <!-- Legal -->
        <Label name="legal" class="text-faint" text="By continuing, you agree to our Terms of Service" style="position: absolute; bottom: 24px; font-size: 14px;" />
    </VisualElement>
</UXML>
