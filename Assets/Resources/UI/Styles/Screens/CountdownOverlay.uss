/* Countdown 3-2-1-GO — full-screen beat, input locked by flow */

.countdown-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(8, 9, 12, 0.35);
}

.countdown-label {
    font-size: 160px;
    color: rgb(248, 250, 252);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.55);
}

.countdown-label.go {
    color: rgb(0, 240, 153);
    font-size: 140px;
    letter-spacing: 8px;
}

.countdown-sub {
    font-size: 18px;
    letter-spacing: 5px;
    color: rgba(248, 250, 252, 0.5);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 8px;
}
